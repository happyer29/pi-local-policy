{
  "name": "pi-local-policy",
  "version": "0.1.0",
  "description": "Local deterministic permissions and macOS confinement for Pi tool calls",
  "type": "module",
  "license": "MIT",
  "author": "happyer29",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/happyer29/pi-local-policy.git"
  },
  "homepage": "https://github.com/happyer29/pi-local-policy#readme",
  "bugs": { "url": "https://github.com/happyer29/pi-local-policy/issues" },
  "publishConfig": { "access": "public", "registry": "https://registry.npmjs.org/" },
  "os": ["darwin"],
  "engines": { "node": ">=22.19.0" },
  "keywords": ["pi-package", "pi", "agents", "permissions", "macos"],
  "pi": { "extensions": ["./src/index.ts"] },
  "files": [
    "src/",
    "docs/",
    ".github/SECURITY.md",
    ".github/CONTRIBUTING.md",
    "scripts/install.mjs",
    "scripts/uninstall.mjs",
    "scripts/management.mjs",
    "README.md",
    "LICENSE"
  ],
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.0.3",
    "typebox": "1.3.27"
  },
  "overrides": {
    "@earendil-works/chord": "1.0.3",
    "@earendil-works/pi-agent-core": "1.0.3",
    "@earendil-works/pi-ai": "1.0.3",
    "@earendil-works/pi-codemode": "1.0.3",
    "@earendil-works/pi-mcp": "1.0.3",
    "@earendil-works/pi-telemetry": "1.0.3",
    "@earendil-works/pi-tui": "1.0.3"
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "test:sandbox": "PI_POLICY_SANDBOX_TEST=1 node --test tests/*.test.mjs",
    "check:release": "node scripts/check-release.mjs",
    "check:package": "node scripts/check-package.mjs"
  }
}
